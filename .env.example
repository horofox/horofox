# ── LLM (필수) ─────────────────────────────
# OpenAI 호환 LLM API 키
OPENAI_API_KEY=
# 선택: 호환 엔드포인트 (예: Z.ai GLM → https://api.z.ai/api/paas/v4)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ── 채널 봇 (선택) ─────────────────────────
# 텔레그램: @BotFather → /newbot 으로 발급
TELEGRAM_BOT_TOKEN=
# 디스코드: discord.com/developers → Bot 토큰 (Message Content Intent 켜기)
DISCORD_BOT_TOKEN=

# ── 온체인 (선택) ──────────────────────────
# onchainBalance 기본 주소. HL_TRADER_KEY 미설정 시 트레이더 키로도 쓰임
EVM_PRIVATEKEY=
# Hyperliquid 네트워크: mainnet(기본) | testnet
HL_NETWORK=mainnet

# ── Hyperliquid 실거래 (LIVE) ──────────────
# 아래 셋이 **모두** 있어야 LIVE 가 켜진다. 하나라도 없으면 자동으로 PAPER.
# 1) 실거래 스위치. 기본은 paper — 실수로 실주문이 나가지 않게.
HL_MODE=paper
# 2) 주문에 서명할 트레이더 개인키 (0x + 64 hex)
HL_TRADER_KEY=
# 3) builder 수수료를 받을 내 지갑. 이게 이 서비스의 유일한 실매출원.
#    ※ Hyperliquid 는 빌더에게 퍼프 계정 가치 100 USDC 이상을 요구한다.
#      미달이면 builder 가 붙은 주문이 전부 거부된다.
HL_BUILDER_ADDRESS=

# 내가 걷는 수수료율(%). 퍼프 상한 0.1%
HL_BUILDER_FEE_PERCENT=0.1
# 유저에게 승인받을 최대 요율(%)
HL_APPROVAL_MAX_FEE_PERCENT=0.1
# 자산별 상한과 별개로 우리가 거는 레버리지 천장
HL_LEVERAGE_CAP=20
# 시장가를 IOC 리밋으로 환산할 때 허용 슬리피지
HL_SLIPPAGE=0.05

# ── 플랫폼 API (선택) ──────────────────────
# 설정 시 /api/v1/* 에 Bearer 인증 요구
AGENT_API_KEY=
# LLM 게이트웨이 키 목록 (쉼표 구분). 미설정 시 게이트웨이 401
GATEWAY_API_KEYS=
# x402 수취 주소. 미설정 시 /api/x402 데모 모드(무료)
X402_PAY_TO=
WEBHOOK_URL=
SWAP_FEE_RATE=0.005
GATEWAY_PRICE_PROMPT_1K=0.001
GATEWAY_PRICE_COMPLETION_1K=0.004
GATEWAY_DEMO_TOPUP=5

# ── 소셜 봇 (유입 채널) ─────────────────────────────
# Farcaster: neynar.com 무료 플랜으로 시작할 수 있다.
NEYNAR_API_KEY=
NEYNAR_SIGNER_UUID=
FARCASTER_FID=
# X: 2026-02 부터 무료 티어가 없다. 링크 포함 게시가 건당 $0.20 이니 상한을 반드시 두라.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_USER_ID=
# 안전장치. dry-run 이 기본이고, 실제 게시는 --live 와 SOCIAL_DRY_RUN=0 을 둘 다 요구한다.
SOCIAL_DRY_RUN=1
SOCIAL_MONTHLY_USD_CAP=5
SOCIAL_POSTS_PER_DAY=3
PUBLIC_SITE_URL=https://horofox.com

# ── x402 v2 · Hedera 결제 ─────────────────────────
# 이 값이 있어야 유료화가 켜진다. 없으면 데모 모드로 무료 응답한다.
HEDERA_ACCOUNT_ID=
HEDERA_MAINNET_ACCOUNT_ID=
HEDERA_NETWORK=testnet
# 퍼실리테이터. 기본값은 Hedera 공식 PoC 와 동일하다.
#   testnet  https://x402.org/facilitator
#   mainnet  https://api.blocky402.com  (Blocky402)
# ETHOnline Hedera 트랙은 Blocky402 정산을 요구하는데 testnet 지원 여부가 미확인이라
# 확인되면 아래로 덮어쓴다.
# 에이전트가 **결제할** 지갑. 이게 있어야 남의 유료 API 를 사올 수 있다.
# portal.hedera.com 에서 테스트넷 계정을 만들면 무료로 받는다 (ECDSA 선택).
# 거래 서명 키(TRADER_KEY)와 별개다 — 이 키는 결제만 한다.
HEDERA_AGENT_ACCOUNT_ID=
HEDERA_AGENT_PRIVATE_KEY=

X402_TESTNET_FACILITATOR_URL=
X402_MAINNET_FACILITATOR_URL=
